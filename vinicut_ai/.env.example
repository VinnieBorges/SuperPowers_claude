# Vinicut AI configuration — copy to `.env` and edit.
# Every value here can also be set as a real environment variable.

# ---------------------------------------------------------------------------
# AI editorial brain
# ---------------------------------------------------------------------------
# Provider: auto | anthropic | ollama | openai
#   auto      -> use Claude when ANTHROPIC_API_KEY is set, else local Ollama
#   anthropic -> Claude API (best quality segmentation/copywriting)
#   ollama    -> fully local via Ollama
#   openai    -> any OpenAI-compatible endpoint (Groq, Together, LM Studio...)
VINICUT_LLM_PROVIDER=auto

# Claude API — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
VINICUT_ANTHROPIC_MODEL=claude-sonnet-5

# Local Ollama
OLLAMA_HOST=http://localhost:11434
VINICUT_OLLAMA_EDIT_MODEL=gemma4:26b
VINICUT_OLLAMA_VISION_MODEL=llama3.2-vision:latest

# OpenAI-compatible endpoint (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VINICUT_OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
VINICUT_WHISPER_MODEL=large-v3

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
VINICUT_HOST=127.0.0.1
VINICUT_PORT=8000
# Comma-separated allowed origins; * for local development.
VINICUT_CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Media / storage
# ---------------------------------------------------------------------------
# VINICUT_FFMPEG=ffmpeg
# VINICUT_FFPROBE=ffprobe
VINICUT_RAW_RETENTION_DAYS=7
VINICUT_LOG_LEVEL=INFO
