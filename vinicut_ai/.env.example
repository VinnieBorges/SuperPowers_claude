# Vinicut AI configuration — copy to `.env` and edit.
# Every value here can also be set as a real environment variable.

# ---------------------------------------------------------------------------
# AI editorial brain
# ---------------------------------------------------------------------------
# Provider: ollama | anthropic | auto | openai
#   ollama    -> fully local via Ollama + Gemma (the primary engine)
#   anthropic -> Claude API (optional cloud upgrade)
#   auto      -> Claude when ANTHROPIC_API_KEY is set, else local Ollama
#   openai    -> any OpenAI-compatible endpoint (Groq, Together, LM Studio...)
VINICUT_LLM_PROVIDER=ollama

# Claude API — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
VINICUT_ANTHROPIC_MODEL=claude-sonnet-5

# Local Ollama
OLLAMA_HOST=http://localhost:11434
# 12B is the recommended speed/quality balance; 26B+ models often exceed the
# request timeout on consumer GPUs. Pick installed models from Settings too.
VINICUT_OLLAMA_EDIT_MODEL=gemma4:12b
VINICUT_OLLAMA_VISION_MODEL=llama3.2-vision:latest
# Seconds before a local LLM call times out (first call includes VRAM load).
VINICUT_LLM_TIMEOUT=300
# Keep the local model loaded between pipeline calls / prompt context window.
VINICUT_OLLAMA_KEEP_ALIVE=15m
VINICUT_OLLAMA_NUM_CTX=8192
# Keep Whisper resident between transcriptions. Default: 1 on Apple Silicon
# (unified memory), 0 on Windows (frees ~3 GB of VRAM for Gemma).
# VINICUT_WHISPER_KEEP_LOADED=1
# M-series Pro/Max with 36+ GB: the macOS installer selects gemma4:26b
# automatically and VINICUT_WORKERS=2 is comfortable.

# OpenAI-compatible endpoint (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VINICUT_OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
VINICUT_WHISPER_MODEL=large-v3
# Transcription language defaults to Portuguese (pt) — all UGC for this brand
# is PT-BR. Change per-install in Settings → Transcription language.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
VINICUT_HOST=127.0.0.1
VINICUT_PORT=8000
# Comma-separated allowed origins; * for local development.
VINICUT_CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Media / storage
# ---------------------------------------------------------------------------
# VINICUT_FFMPEG=ffmpeg
# VINICUT_FFPROBE=ffprobe
VINICUT_RAW_RETENTION_DAYS=7
VINICUT_LOG_LEVEL=INFO

# Concurrent project workers (1-4). Keep 1 unless your GPU has spare NVENC
# sessions; 2 is a good value on RTX cards.
VINICUT_WORKERS=1
